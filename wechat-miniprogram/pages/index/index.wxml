<view wx:if="{{view == 'setup'}}" class="setup-screen">
  <view class="floating-stars">
    <view></view><view></view><view></view>
  </view>
  <view class="setup-panel">
    <view class="brand-row">
      <image class="logo-image bounce-in" src="/assets/logo.svg" mode="aspectFit" />
      <view>
        <text class="eyebrow">基层老年认知筛查</text>
        <text class="page-title">参加者登录</text>
      </view>
    </view>
    <view class="setup-grid">
      <view class="field">
        <text>参加者姓名</text>
        <input data-key="name" value="{{participant.name}}" bindinput="onParticipantInput" />
      </view>
      <view class="field">
        <text>年龄</text>
        <input type="number" data-key="age" value="{{participant.age}}" bindinput="onParticipantInput" />
      </view>
      <view class="field">
        <text>性别</text>
        <picker range="{{sexOptions}}" value="{{sexIndex}}" bindchange="onSexChange">
          <view class="picker-box">{{participant.sex || '请选择'}}</view>
        </picker>
      </view>
      <view class="field">
        <text>教育水平</text>
        <picker range="{{educationOptions}}" value="{{educationIndex}}" bindchange="onEducationChange">
          <view class="picker-box">{{participant.educationLevel || '请选择'}}</view>
        </picker>
      </view>
    </view>
    <view class="setup-actions">
      <button class="primary big-button" bindtap="startSession">开始测评</button>
    </view>
    <text class="fineprint">横屏平板使用，每次作答占满一页。后台自动记录总分、每题得分和作答行为。</text>
  </view>
</view>

<view wx:else class="app-shell">
  <view class="hidden-drawer {{menuOpen ? 'open' : ''}}">
    <view class="drawer-mask" bindtap="closeMenu"></view>
    <view class="drawer-panel">
      <view class="drawer-brand">
        <image class="drawer-logo" src="/assets/logo.svg" mode="aspectFit" />
        <view>
          <text class="brand-name">MoCA Quest</text>
          <text class="brand-subtitle">{{participant.name || '未填写姓名'}}</text>
        </view>
      </view>
      <button class="drawer-item" data-view="test" bindtap="navView">任务</button>
      <button class="drawer-item" data-view="results" bindtap="navView">结果</button>
      <button class="drawer-item" data-view="admin" bindtap="navView">后台</button>
      <button class="drawer-item" data-view="design" bindtap="navView">技术细节</button>
      <button class="drawer-item" bindtap="goHome">返回首页</button>
      <view class="drawer-progress">
        <text>{{progressText}}</text>
        <view class="mini-progress"><view style="width: {{progressWidth}};"></view></view>
      </view>
      <view class="drawer-task-list">
        <button wx:for="{{taskNav}}" wx:key="id" class="drawer-task {{item.done ? 'done' : ''}}" data-index="{{index}}" bindtap="selectTask">
          <text>{{index + 1}}</text>
          <text>{{item.title}}</text>
        </button>
      </view>
    </view>
  </view>

  <view class="page-shell">
    <view class="page-header">
      <button class="icon-button" bindtap="openMenu">≡</button>
      <view class="header-title">
        <text class="eyebrow">{{current.domain}}</text>
        <text class="view-title">{{view == 'results' ? '测评结果' : view == 'admin' ? '后台数据库' : view == 'design' ? '技术细节' : current.title}}</text>
      </view>
      <view class="header-progress">
        <text>{{progressText}}</text>
        <view class="progress-track"><view style="width: {{progressWidth}};"></view></view>
      </view>
    </view>

    <view wx:if="{{view == 'results'}}" class="single-page results-page">
      <view class="result-hero">
        <text class="result-label">总分</text>
        <text class="result-score">{{totals.totalScore}}</text>
        <text class="result-max">/30</text>
        <text class="risk-text">{{totals.riskBand}}</text>
      </view>
      <view class="domain-table">
        <view wx:for="{{domainRows}}" wx:key="domain" class="domain-row">
          <text>{{item.domain}}</text>
          <text class="strong">{{item.score}}/{{item.max}}</text>
        </view>
      </view>
      <view class="control-row">
        <button class="primary" bindtap="saveSession">保存到后台数据库</button>
        <button class="ghost" bindtap="newSession">新测评</button>
      </view>
    </view>

    <view wx:elif="{{view == 'admin'}}" class="single-page admin-page">
      <view class="admin-toolbar">
        <button class="primary" bindtap="loadSessions">刷新数据库</button>
        <button class="secondary" bindtap="saveSession">保存当前测评</button>
        <button class="ghost" bindtap="copySelectedJson">复制JSON</button>
      </view>
      <view class="admin-table">
        <view class="admin-head">
          <text>参加者</text><text>总分</text><text>原始分</text><text>保存时间</text>
        </view>
        <button wx:for="{{adminSessions}}" wx:key="id" class="admin-row" data-id="{{item.id}}" bindtap="selectSavedSession">
          <text>{{item.participant.name || item.id}}</text>
          <text>{{item.totalScore}}/30</text>
          <text>{{item.rawScore}}</text>
          <text>{{item.finishedAt || '-'}}</text>
        </button>
        <text wx:if="{{adminSessions.length == 0}}" class="empty">暂无保存记录</text>
      </view>
      <view class="json-preview"><text>{{selectedSessionText}}</text></view>
    </view>

    <view wx:elif="{{view == 'design'}}" class="single-page design-page">
      <view class="design-note">
        <text class="section-title">核心设计</text>
        <text>每道题是一张横屏任务页，选择题、语音、画图和行为记录统一写入后台。评分标准仍按附件 MoCA 映射，答题端不展示评分标准。</text>
      </view>
      <view class="design-grid">
        <view wx:for="{{tasks}}" wx:key="id" class="design-card">
          <text class="domain-text">{{item.domain}}</text>
          <text class="design-title">{{item.title}}</text>
          <text>{{item.modality}}</text>
        </view>
      </view>
    </view>

    <view wx:else class="single-page task-page">
      <view class="task-copy">
        <view class="task-badge-row">
          <text class="domain-badge">{{current.domain}}</text>
          <text class="step-badge">{{stepText}}</text>
        </view>
        <text class="task-heading">{{current.title}}</text>
        <text class="prompt">{{current.prompt}}</text>
        <text wx:if="{{pageHint}}" class="page-hint">{{pageHint}}</text>
        <view class="cute-helper floaty">
          <image src="/assets/logo.svg" mode="aspectFit" />
        </view>
      </view>

      <view class="task-workspace">
        <view wx:if="{{current.type == 'trail'}}" class="trail-page">
          <canvas canvas-id="taskCanvas" class="task-canvas" style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;" bindtouchstart="onCanvasStart"></canvas>
          <view class="control-row">
            <button class="ghost" bindtap="undoTrail">撤销一步</button>
            <button class="ghost" bindtap="clearTrail">重画</button>
          </view>
        </view>

        <view wx:elif="{{current.type == 'drawing'}}" class="drawing-page {{current.drawingKind == 'clock' ? 'clock-page' : ''}}">
          <view wx:if="{{current.drawingKind == 'cube'}}" class="reference-panel">
            <canvas canvas-id="refCanvas" class="ref-canvas" style="width: 240px; height: 190px;"></canvas>
          </view>
          <view class="canvas-wrap">
            <text wx:if="{{current.drawingKind == 'clock'}}" class="clock-label">11:10</text>
            <canvas canvas-id="taskCanvas" class="task-canvas" style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;" bindtouchstart="onCanvasStart" bindtouchmove="onCanvasMove" bindtouchend="onCanvasEnd"></canvas>
            <button class="ghost redraw-button" bindtap="clearDrawing">重画</button>
          </view>
        </view>

        <view wx:elif="{{current.type == 'naming'}}" class="naming-page">
          <image class="animal-photo pop-in" src="{{animalPage.asset}}" mode="aspectFit" />
          <text class="animal-question">{{animalPage.prompt}}</text>
          <view class="option-grid">
            <button wx:for="{{namingOptions}}" wx:key="value" class="option {{item.picked ? 'picked' : ''}}" data-value="{{item.value}}" bindtap="chooseNaming">{{item.value}}</button>
          </view>
        </view>

        <view wx:elif="{{current.type == 'memory'}}" class="memory-page">
          <view wx:if="{{!memoryReady}}" class="wait-card">
            <text class="wait-title">请休息一下</text>
            <text class="wait-count">{{memoryWaitRemainingText}}</text>
            <text>第二次词语学习将在倒计时结束后开始。</text>
          </view>
          <view wx:else class="voice-card">
            <view class="audio-visual">
              <view class="headphone-icon"></view>
              <view class="sound-wave"></view>
            </view>
            <button class="primary circle-button" bindtap="playCurrentAudio">播放词语</button>
          </view>
        </view>

        <view wx:elif="{{current.type == 'choice'}}" class="digit-page">
          <button class="primary sound-button" bindtap="playCurrentAudio">播放声音</button>
          <view class="digit-answer">
            <text wx:for="{{selectedDigits}}" wx:key="index">{{item}}</text>
          </view>
          <view class="keypad digit-keypad">
            <button wx:for="{{digitPad}}" wx:key="*this" data-digit="{{item}}" bindtap="appendDigit">{{item}}</button>
            <button class="key-wide" bindtap="backspaceDigit">退格</button>
          </view>
        </view>

        <view wx:elif="{{current.type == 'vigilance'}}" class="vigilance-page">
          <button wx:if="{{!vigilanceStarted}}" class="primary circle-button" bindtap="playCurrentAudio">开始</button>
          <button wx:else class="tap-button pulse" bindtap="tapVigilance">敲一下</button>
          <text wx:if="{{vigilanceStarted}}" class="tap-count">已敲 {{vigilanceTapCount}} 次</text>
        </view>

        <view wx:elif="{{current.type == 'serial7'}}" class="serial-page">
          <text class="math-question">{{serialQuestion}}</text>
          <view class="serial-display">{{serialDisplay || ' '}}</view>
          <view class="keypad">
            <button wx:for="{{digitPad}}" wx:key="*this" data-digit="{{item}}" bindtap="inputSerialDigit">{{item}}</button>
            <button class="key-wide" bindtap="backspaceSerial">退格</button>
          </view>
        </view>

        <view wx:elif="{{current.type == 'sentence'}}" class="speech-page">
          <view class="audio-visual">
            <view class="headphone-icon"></view>
            <view class="mic-icon {{voiceState == '请说' ? 'recording' : ''}}"></view>
          </view>
          <button class="primary sound-button" bindtap="playCurrentAudio">{{playState}}</button>
          <button class="ghost" bindtap="toggleVoiceInput">{{voiceState == '请说' ? '停止识别' : '请说'}}</button>
          <text class="transcript">{{sentencePage.value || '等待语音识别...'}}</text>
        </view>

        <view wx:elif="{{current.type == 'fluency'}}" class="fluency-page">
          <button class="timer-button {{fluencyRunning ? 'running' : ''}}" bindtap="startFluency">{{fluencyRunning ? fluencyRemaining : '开始'}}</button>
          <text class="count-label">已识别 {{fluencyCount}} 个</text>
          <text class="transcript">{{voiceText || '点击开始后说动物名'}}</text>
        </view>

        <view wx:elif="{{current.type == 'abstractionSpeech'}}" class="speech-page">
          <text class="pair-title">{{abstractionPage.pair}}</text>
          <button class="primary sound-button" bindtap="playCurrentAudio">播放</button>
          <button class="ghost" bindtap="toggleVoiceInput">{{voiceState == '请说' ? '停止识别' : '请说'}}</button>
          <text class="transcript">{{abstractionPage.value || '等待语音识别...'}}</text>
        </view>

        <view wx:elif="{{current.type == 'recall'}}" class="speech-page">
          <view class="audio-visual">
            <view class="mic-icon {{voiceState == '请说' ? 'recording' : ''}}"></view>
          </view>
          <button class="primary sound-button" bindtap="playCurrentAudio">播放提示</button>
          <button class="ghost" bindtap="toggleVoiceInput">{{voiceState == '请说' ? '停止识别' : '请说'}}</button>
          <text class="transcript">{{recallText || '等待语音识别...'}}</text>
        </view>

        <view wx:elif="{{current.type == 'orientation'}}" class="speech-page">
          <text class="orientation-question">{{orientationPage.label}}</text>
          <text class="location-text">{{locationStatus}}</text>
          <button class="primary sound-button" bindtap="playCurrentAudio">播放</button>
          <button class="ghost" bindtap="toggleVoiceInput">{{voiceState == '请说' ? '停止识别' : '请说'}}</button>
          <text class="transcript">{{orientationPage.value || '等待语音识别...'}}</text>
        </view>
      </view>

      <view class="task-footer">
        <button class="ghost" disabled="{{activeTaskIndex == 0}}" bindtap="previousTask">上一页</button>
        <button class="primary" disabled="{{nextDisabled}}" bindtap="nextTask">{{nextLabel}}</button>
      </view>
    </view>
  </view>
</view>
