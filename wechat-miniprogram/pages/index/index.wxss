:host {
  color: #243447;
}

.setup-screen,
.app-shell {
  min-height: 100vh;
}

.setup-screen {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}

.setup-panel {
  width: 92vw;
  padding: 34rpx;
  border: 2rpx solid #dfe7ee;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 48rpx rgba(36, 52, 71, 0.12);
}

.brand-row,
.mini-brand,
.topbar,
.task-footer,
.control-row,
.setup-actions,
.admin-toolbar {
  display: flex;
  align-items: center;
}

.brand-row {
  gap: 18rpx;
  margin-bottom: 26rpx;
}

.mascot {
  position: relative;
  width: 78rpx;
  height: 78rpx;
  flex: 0 0 auto;
  border-radius: 8rpx;
  background: #20a66b;
  box-shadow: inset 0 -8rpx 0 rgba(0, 0, 0, 0.08);
}

.mascot::before,
.mascot::after {
  content: "";
  position: absolute;
  top: 22rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: #fff;
  box-shadow: inset 0 0 0 5rpx #243447;
}

.mascot::before {
  left: 18rpx;
}

.mascot::after {
  right: 18rpx;
}

.mascot view {
  position: absolute;
  left: 27rpx;
  top: 48rpx;
  width: 24rpx;
  height: 10rpx;
  border-radius: 0 0 18rpx 18rpx;
  background: #ffd45a;
}

.mascot.small {
  width: 46rpx;
  height: 46rpx;
}

.mascot.small::before,
.mascot.small::after {
  top: 13rpx;
  width: 11rpx;
  height: 11rpx;
  box-shadow: inset 0 0 0 3rpx #243447;
}

.mascot.small::before {
  left: 11rpx;
}

.mascot.small::after {
  right: 11rpx;
}

.mascot.small view {
  left: 15rpx;
  top: 29rpx;
  width: 16rpx;
  height: 7rpx;
}

.eyebrow {
  display: block;
  margin-bottom: 4rpx;
  color: #128252;
  font-size: 26rpx;
  font-weight: 800;
}

.page-title {
  display: block;
  font-size: 42rpx;
  font-weight: 900;
}

.setup-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16rpx;
}

.field {
  display: grid;
  gap: 8rpx;
  color: #718094;
  font-weight: 700;
}

.field input,
.picker-box,
textarea,
.animal-input {
  width: 100%;
  min-height: 48rpx;
  box-sizing: border-box;
  border: 2rpx solid #dfe7ee;
  border-radius: 8rpx;
  background: #fff;
  color: #243447;
  padding: 13rpx 14rpx;
}

.setup-actions,
.control-row,
.admin-toolbar {
  gap: 12rpx;
  margin-top: 22rpx;
}

.primary,
.secondary,
.ghost,
.selected,
.option,
.task-pill,
.admin-row,
.tap-button,
.animal-tags button {
  border-radius: 8rpx;
  transition: transform 0.15s ease;
}

.primary,
.secondary,
.selected,
.tap-button {
  color: #fff;
  font-weight: 850;
}

.primary {
  background: #20a66b;
}

.secondary {
  background: #3d8bfd;
}

.selected {
  background: #7c6ee6;
}

.ghost {
  border: 2rpx solid #dfe7ee;
  background: #fff;
  color: #243447;
  font-weight: 800;
}

.fineprint {
  display: block;
  margin-top: 20rpx;
  color: #718094;
  line-height: 1.7;
}

.app-shell {
  display: grid;
  grid-template-columns: 286rpx minmax(0, 1fr);
  gap: 18rpx;
  padding: 18rpx;
  box-sizing: border-box;
}

.sidebar,
.main-panel {
  height: calc(100vh - 36rpx);
  background: rgba(255, 255, 255, 0.94);
  border: 2rpx solid #dfe7ee;
  border-radius: 8rpx;
  box-shadow: 0 18rpx 48rpx rgba(36, 52, 71, 0.12);
  box-sizing: border-box;
}

.sidebar {
  padding: 16rpx;
}

.mini-brand {
  gap: 12rpx;
}

.brand-name,
.brand-subtitle {
  display: block;
}

.brand-name {
  font-weight: 900;
}

.brand-subtitle {
  color: #718094;
  font-size: 24rpx;
}

.score-orb {
  display: flex;
  justify-content: center;
  align-items: baseline;
  gap: 5rpx;
  margin: 16rpx 0;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #25364a;
  color: #fff;
}

.score-number {
  font-size: 44rpx;
  font-weight: 900;
}

.task-list {
  display: grid;
  gap: 8rpx;
}

.task-pill {
  display: grid;
  grid-template-columns: 30rpx minmax(0, 1fr);
  grid-template-rows: auto auto;
  align-items: center;
  gap: 4rpx 8rpx;
  width: 100%;
  min-height: 70rpx;
  padding: 9rpx 10rpx;
  border: 2rpx solid #dfe7ee;
  background: #fff;
  color: #243447;
  text-align: left;
}

.task-index {
  display: grid;
  place-items: center;
  width: 26rpx;
  height: 26rpx;
  border-radius: 8rpx;
  background: #eef4f8;
  color: #718094;
  font-size: 22rpx;
  font-weight: 900;
}

.task-title {
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-state {
  grid-column: 2;
  color: #718094;
  font-size: 20rpx;
  font-weight: 800;
}

.task-pill.active {
  border-color: #20a66b;
  box-shadow: 0 0 0 4rpx rgba(32, 166, 107, 0.12);
}

.task-pill.done .task-index {
  background: #20a66b;
  color: #fff;
}

.main-panel {
  display: grid;
  grid-template-rows: auto minmax(0, 1fr);
  overflow: hidden;
}

.topbar {
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 22rpx 14rpx;
  border-bottom: 2rpx solid #dfe7ee;
}

.view-title {
  display: block;
  font-size: 34rpx;
  font-weight: 900;
}

.top-actions {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.top-actions button {
  min-height: 54rpx;
  padding: 0 18rpx;
  font-size: 24rpx;
}

.task-stage {
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) auto;
  min-height: 0;
  padding: 16rpx 22rpx 18rpx;
  box-sizing: border-box;
}

.progress-track {
  height: 12rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #e9eef3;
}

.progress-track view {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #20a66b, #ffd45a);
}

.task-card {
  display: grid;
  grid-template-columns: minmax(260rpx, 0.8fr) minmax(520rpx, 1.5fr);
  gap: 18rpx;
  min-height: 0;
  margin-top: 16rpx;
}

.task-copy,
.task-workspace {
  min-height: 0;
  border: 2rpx solid #dfe7ee;
  border-radius: 8rpx;
  background: #fffdf7;
  box-sizing: border-box;
}

.task-copy {
  padding: 24rpx;
}

.task-workspace {
  padding: 18rpx;
}

.domain-badge {
  display: inline-block;
  margin-bottom: 14rpx;
  padding: 7rpx 10rpx;
  border-radius: 8rpx;
  background: #e8f8ef;
  color: #128252;
  font-weight: 900;
}

.task-heading {
  display: block;
  margin-bottom: 14rpx;
  font-size: 38rpx;
  font-weight: 900;
}

.prompt {
  color: #243447;
  font-size: 30rpx;
  line-height: 1.7;
}

.task-footer {
  justify-content: space-between;
  gap: 12rpx;
  padding-top: 14rpx;
}

.footer-score {
  color: #718094;
  font-weight: 900;
}

.task-canvas {
  display: block;
  border: 4rpx solid #cad7e3;
  border-radius: 8rpx;
  background: #fffdf7;
}

.drawing-layout {
  display: grid;
  grid-template-columns: 240rpx minmax(0, 1fr);
  gap: 14rpx;
}

.drawing-layout.no-reference {
  grid-template-columns: 1fr;
}

.reference-panel {
  display: grid;
  place-items: center;
  border: 2rpx solid #dfe7ee;
  border-radius: 8rpx;
  background: #fff;
}

.ref-canvas {
  display: block;
}

.status-bar {
  margin-top: 14rpx;
  padding: 12rpx;
  border-radius: 8rpx;
  background: #f0f5f9;
  color: #243447;
  font-weight: 800;
}

.animal-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.animal-card,
.sentence-card,
.abstract-card,
.design-card {
  border: 2rpx solid #dfe7ee;
  border-radius: 8rpx;
  background: #fff;
  padding: 14rpx;
}

.animal-visual {
  position: relative;
  height: 150rpx;
  margin-bottom: 12rpx;
  border-radius: 8rpx;
  background: #fff7df;
  overflow: hidden;
}

.animal-visual::before {
  content: "";
  position: absolute;
  left: 48rpx;
  top: 36rpx;
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  background: #ffd46b;
  box-shadow: 82rpx 30rpx 0 8rpx #f4bd5f;
}

.animal-visual::after {
  content: "";
  position: absolute;
  left: 80rpx;
  top: 72rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #243447;
  box-shadow: 24rpx 0 0 #243447;
}

.animal-visual.rhino::before {
  background: #b7c4ca;
  box-shadow: 78rpx 10rpx 0 18rpx #cbd5da;
}

.animal-visual.rhino view {
  position: absolute;
  right: 20rpx;
  top: 52rpx;
  width: 0;
  height: 0;
  border-top: 18rpx solid transparent;
  border-bottom: 18rpx solid transparent;
  border-left: 50rpx solid #f4efe4;
}

.animal-visual.camel::before {
  width: 150rpx;
  height: 58rpx;
  top: 66rpx;
  border-radius: 28rpx;
  background: #d69a55;
  box-shadow: 110rpx -30rpx 0 -6rpx #d69a55;
}

.option-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.option-grid.wide {
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-top: 18rpx;
}

.option {
  min-height: 56rpx;
  border: 2rpx solid #dfe7ee;
  background: #fff;
  color: #243447;
  font-weight: 900;
  font-size: 26rpx;
}

.option.picked,
.word-chip.picked {
  border-color: #20a66b;
  background: #e8f8ef;
  box-shadow: 0 0 0 4rpx rgba(32, 166, 107, 0.12);
}

.word-ribbon,
.animal-tags,
.digit-stream {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.word-chip,
.digit-stream text {
  display: grid;
  place-items: center;
  min-width: 76rpx;
  height: 58rpx;
  border: 2rpx solid transparent;
  border-radius: 8rpx;
  background: #ffd45a;
  color: #503f00;
  font-weight: 900;
}

.digit-chip {
  display: inline-grid;
  place-items: center;
  min-width: 220rpx;
  min-height: 92rpx;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  background: #25364a;
  color: #fff;
  font-size: 42rpx;
  font-weight: 950;
}

.centered {
  justify-content: center;
}

.tap-button {
  min-width: 168rpx;
  min-height: 168rpx;
  border-radius: 999rpx;
  background: #ff7f68;
}

.serial-row,
.orientation-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.number-step {
  display: grid;
  gap: 8rpx;
  padding: 14rpx;
  border: 2rpx solid #dfe7ee;
  border-radius: 8rpx;
  background: #fff;
  color: #718094;
  font-weight: 800;
}

.number-step input {
  border-bottom: 4rpx solid #20a66b;
  color: #243447;
  font-size: 38rpx;
  font-weight: 900;
  text-align: center;
}

.sentence-list,
.fluency-panel,
.abstract-panel {
  display: grid;
  gap: 14rpx;
}

.sentence-label,
.pair-title {
  display: block;
  margin-bottom: 10rpx;
  font-weight: 900;
}

.sentence-card textarea,
.large-textarea {
  min-height: 140rpx;
}

.timer-face {
  display: grid;
  place-items: center;
  width: 152rpx;
  height: 152rpx;
  margin: 0 auto;
  border-radius: 999rpx;
  background: #25364a;
  color: #fff;
  font-size: 54rpx;
  font-weight: 950;
}

.animal-input {
  width: 280rpx;
}

.animal-tags button {
  padding: 8rpx 12rpx;
  border: 2rpx solid #dfe7ee;
  background: #fff;
  color: #243447;
  font-weight: 800;
}

.results-grid,
.admin-layout,
.design-layout {
  height: 100%;
  padding: 22rpx;
  box-sizing: border-box;
}

.results-grid {
  display: grid;
  grid-template-columns: 280rpx minmax(0, 1fr);
  grid-auto-rows: min-content;
  gap: 18rpx;
}

.result-hero,
.domain-table,
.metric-strip,
.admin-table,
.json-preview,
.design-note,
.design-card {
  border: 2rpx solid #dfe7ee;
  border-radius: 8rpx;
  background: #fff;
}

.result-hero {
  display: grid;
  place-items: center;
  min-height: 280rpx;
  padding: 20rpx;
  text-align: center;
}

.result-score {
  font-size: 84rpx;
  font-weight: 950;
}

.result-max {
  color: #718094;
  font-size: 30rpx;
  font-weight: 900;
}

.risk-text {
  color: #243447;
  font-weight: 800;
}

.domain-row,
.metric-strip view,
.admin-head,
.admin-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 12rpx;
  align-items: center;
  padding: 12rpx;
  border-bottom: 2rpx solid #dfe7ee;
}

.domain-row:last-child,
.metric-strip view:last-child {
  border-bottom: 0;
}

.strong {
  font-size: 30rpx;
  font-weight: 900;
}

.metric-strip {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.admin-layout {
  display: grid;
  grid-template-rows: auto minmax(220rpx, 0.9fr) minmax(220rpx, 1fr);
  gap: 14rpx;
}

.admin-table {
  overflow: hidden;
}

.admin-head,
.admin-row {
  grid-template-columns: 1.2fr 0.7fr 0.7fr 1fr 1.6fr;
  width: 100%;
  box-sizing: border-box;
  text-align: left;
}

.admin-head {
  background: #25364a;
  color: #fff;
  font-weight: 900;
}

.admin-row {
  background: #fff;
  color: #243447;
  font-size: 24rpx;
}

.json-preview {
  padding: 16rpx;
  color: #243447;
  white-space: pre-wrap;
}

.empty {
  display: block;
  padding: 18rpx;
  color: #718094;
}

.design-layout {
  display: grid;
  gap: 14rpx;
}

.design-note,
.design-card {
  display: grid;
  gap: 8rpx;
  padding: 16rpx;
  line-height: 1.65;
}

.section-title,
.design-title {
  font-size: 30rpx;
  font-weight: 900;
}

.domain-text {
  color: #128252;
  font-weight: 900;
}

@media (max-width: 900px), (orientation: portrait) {
  .app-shell {
    grid-template-columns: 1fr;
  }

  .sidebar,
  .main-panel {
    height: auto;
  }

  .task-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .task-card,
  .drawing-layout,
  .results-grid {
    grid-template-columns: 1fr;
  }

  .setup-grid,
  .serial-row,
  .orientation-grid,
  .metric-strip,
  .animal-grid,
  .option-grid.wide {
    grid-template-columns: 1fr 1fr;
  }
}
